DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id
UPDATE_SCHEDULE=daily
UPDATE_HOUR=12

# Integración local con WOL-Bot (todos opcionales; estos son los defaults).
WOL_PYTHON=/home/luca/discord-wake-on-lan/venv/bin/python
WOL_CTL=/home/luca/discord-wake-on-lan/wolctl.py
WOL_ATTEMPTS=3
WOL_ATTEMPT_TIMEOUT_SECS=180
WOL_POLL_SECS=10
WOL_BOOT_GRACE_SECS=90
WOL_ANSIBLE_READY_TIMEOUT_SECS=90
WOL_MAINTENANCE_TTL_SECS=10800

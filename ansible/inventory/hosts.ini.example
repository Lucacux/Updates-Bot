[arch]
your-arch-host ansible_connection=local

[ubuntu]
your-ubuntu-host ansible_host=192.168.x.x ansible_user=youruser ansible_ssh_private_key_file=~/.ssh/id_ed25519_ansible ansible_port=22

# El alias DEBE ser 'sempron': el bot matchea las líneas `[sempron]` del output
# de Ansible para reportar sus paquetes. ansible_host lleva la IP real.
[debian]
sempron ansible_host=192.168.2.20 ansible_user=youruser ansible_ssh_private_key_file=~/.ssh/id_ed25519_ansible ansible_port=22

# ── Proxmox ────────────────────────────────────────────────────────────
# El HYPERVISOR, no un guest. Va como root: `pct`, `apt` y `pveversion` piden
# root, y un sudoers acotado a esos binarios no alcanza porque el módulo apt
# de Ansible corre un intérprete Python completo del otro lado. Por eso
# `become: false` en los playbooks que lo apuntan.
# En el PVE, el acceso debe quedar keys-only (`PermitRootLogin prohibit-password`
# + `PasswordAuthentication no`): es root por SSH sobre la máquina que aloja
# todo lo demás.
[proxmox_host]
pve ansible_host=192.168.1.70 ansible_user=root ansible_ssh_private_key_file=~/.ssh/id_ed25519_ansible ansible_port=22

# VM Debian en Proxmox (vmid 100), grupo propio 'proxmox_debian'. Ojo: los
# nombres de GRUPO van con guion_bajo (Ansible avisa "Invalid characters were
# found in group names" con guion medio, y ese warning termina en los embeds de
# Discord). El `target` de config.py es independiente y sí lleva guion medio:
# 'proxmox-debian'.
[proxmox_debian]
debian-monitoring ansible_host=192.168.1.60 ansible_user=youruser ansible_ssh_private_key_file=~/.ssh/id_ed25519_ansible ansible_port=22

# LXC Alpine SIN SSH propio: Ansible entra por SSH al HOST Proxmox y ejecuta
# `pct exec <vmid>` (community.proxmox.proxmox_pct_remote). ansible_host es
# la IP del host Proxmox, NO la del LXC. proxmox_vmid es el ID del contenedor.
#
# ansible_user TIENE que ser un usuario que pueda correr `pct` sin sudo — root
# en la práctica. El plugin es paramiko y, cuando el usuario remoto no existe,
# el error que devuelve es "Private key file is encrypted": mentira, la key
# está bien, lo que falló es la autenticación. Si ves eso, verificá primero que
# el usuario exista en el host Proxmox.
[lxc_alpine]
alpine-monitoring ansible_host=192.168.1.70 ansible_user=root ansible_ssh_private_key_file=~/.ssh/id_ed25519_ansible ansible_port=22 ansible_connection=community.proxmox.proxmox_pct_remote proxmox_vmid=101

# VM Alpine que el controller NO alcanza directo (firewall entre VLANs). Se
# llega saltando por el hypervisor, sin abrir nada en el router. Descomentar
# cuando la VM tenga la key de Ansible y una lease fija:
# [alpine_vm]
# tailscale-alpine ansible_host=192.168.1.209 ansible_user=luca ansible_ssh_private_key_file=~/.ssh/id_ed25519_ansible ansible_port=22 ansible_ssh_common_args='-o ProxyJump=root@192.168.1.70'

[servers:children]
arch
ubuntu
debian
proxmox_host
proxmox_debian
lxc_alpine
